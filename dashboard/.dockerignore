# Build context for dashboard/Dockerfile is this directory (dashboard/) —
# see docker-compose.yml. Everything here is either local dev cruft or
# gets rebuilt from scratch inside the container, so none of it should be
# sent to the Docker daemon as build context.

node_modules
dist
build
.vite

npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# editor/OS/VCS noise
.git
.gitignore
.DS_Store
*.local
.vscode
.idea

# leftover Vite temp files from interrupted dev/build runs
vite.config.*.timestamp-*
*.tsbuildinfo
