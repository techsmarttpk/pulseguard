# ==============================================================================
# PulseGuard environment configuration
# Copy to .env and adjust as needed. docker-compose.yml reads this file.
# ==============================================================================

# ---- Kafka ----
# KAFKA_BOOTSTRAP_SERVERS is what every PulseGuard container uses
# (Docker-network hostname). The broker also publishes a host-reachable
# listener at localhost:29092 (see docker-compose.yml) if you want to point
# a local script or a Kafka UI tool at it from outside Docker.
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_TOPIC_MARKET_DATA=market-data
KAFKA_TOPIC_DEAD_LETTER=market-data-dead-letter
KAFKA_TOPIC_ALERTS=alerts
KAFKA_CONSUMER_GROUP_INGESTION=pulseguard-ingestion
KAFKA_CONSUMER_GROUP_ANOMALY=pulseguard-anomaly-detection
KAFKA_CONSUMER_CONCURRENCY=4

# ---- Postgres ----
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=pulseguard
POSTGRES_USER=pulseguard
POSTGRES_PASSWORD=pulseguard_dev_password
DATABASE_URL=postgresql://pulseguard:pulseguard_dev_password@postgres:5432/pulseguard

# ---- Simulator ----
SIMULATOR_SYMBOLS=AAPL,MSFT,NVDA,GOOGL,AMZN,TSLA,META
SIMULATOR_EXCHANGES=NASDAQ,NYSE
SIMULATOR_THROUGHPUT_MSG_PER_SEC=1000
SIMULATOR_RUN_DURATION_SECONDS=0

# Anomaly / failure injection probabilities (0.0 - 1.0), applied per message unless noted
SIMULATOR_INJECT_ENABLED=true
SIMULATOR_INJECT_PRICE_SPIKE_PROB=0.0008
SIMULATOR_INJECT_PRICE_CRASH_PROB=0.0008
SIMULATOR_INJECT_NEGATIVE_PRICE_PROB=0.0003
SIMULATOR_INJECT_ZERO_PRICE_PROB=0.0003
SIMULATOR_INJECT_BAD_BID_ASK_PROB=0.0005
SIMULATOR_INJECT_EXTREME_QUANTITY_PROB=0.0005
SIMULATOR_INJECT_DUPLICATE_PROB=0.0008
SIMULATOR_INJECT_SEQUENCE_GAP_PROB=0.0008
SIMULATOR_INJECT_STALE_EVENT_PROB=0.0005
SIMULATOR_INJECT_DELAYED_EVENT_PROB=0.0008
SIMULATOR_INJECT_CORRUPTED_EVENT_PROB=0.0003

# Episodic / time-based injections (not per-message)
SIMULATOR_INJECT_BURST_ENABLED=true
SIMULATOR_INJECT_BURST_INTERVAL_SECONDS=90
SIMULATOR_INJECT_BURST_DURATION_SECONDS=5
SIMULATOR_INJECT_BURST_MULTIPLIER=8

SIMULATOR_INJECT_PAUSE_ENABLED=true
SIMULATOR_INJECT_PAUSE_INTERVAL_SECONDS=120
SIMULATOR_INJECT_PAUSE_DURATION_SECONDS=3

SIMULATOR_INJECT_OUTAGE_ENABLED=false
SIMULATOR_INJECT_OUTAGE_INTERVAL_SECONDS=300
SIMULATOR_INJECT_OUTAGE_DURATION_SECONDS=15

# ---- Ingestion service ----
INGESTION_LOG_LEVEL=INFO
INGESTION_BATCH_SIZE=500
INGESTION_STALE_THRESHOLD_SECONDS=5.0
INGESTION_DUPLICATE_CACHE_SIZE=50000
INGESTION_SEQUENCE_GAP_TRACK_WINDOW=200
INGESTION_EXTREME_QUANTITY_THRESHOLD=1000000
METRICS_PORT_INGESTION=9101

# ---- Anomaly detection service ----
ANOMALY_ZSCORE_THRESHOLD=4.0
ANOMALY_PCT_CHANGE_THRESHOLD=0.03
ANOMALY_ROLLING_WINDOW_SIZE=100
ANOMALY_ISOLATION_FOREST_CONTAMINATION=0.02
ANOMALY_ISOLATION_FOREST_RETRAIN_EVERY_N=2000
ANOMALY_ISOLATION_FOREST_MIN_TRAIN_SAMPLES=300
METRICS_PORT_ANOMALY=9102

# ---- Monitoring / feed health / alerting service ----
MONITORING_HEALTHY_MIN_MSG_PER_SEC=50
MONITORING_DEGRADED_MIN_MSG_PER_SEC=5
MONITORING_STALE_NO_MESSAGE_SECONDS=5
MONITORING_OFFLINE_NO_MESSAGE_SECONDS=15
MONITORING_P99_LATENCY_ALERT_SECONDS=1.0
MONITORING_ERROR_RATE_ALERT_THRESHOLD=0.05
MONITORING_ALERT_COOLDOWN_SECONDS=60
METRICS_PORT_MONITORING=9103

# ---- API ----
API_HOST=0.0.0.0
API_PORT=8000
API_CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ---- Dashboard ----
VITE_API_BASE_URL=http://localhost:8000
